{
  "name": "cypressautomationtesting",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "reporter": "npx cypress run",
    "chrome": "npx cypress open --e2e --browser chrome"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterKuzyk/CypressAutomationTesting.git"
  },
  "author": "Peter Kuzyk",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PeterKuzyk/CypressAutomationTesting/issues"
  },
  "homepage": "https://github.com/PeterKuzyk/CypressAutomationTesting#readme",
  "description": "### Setup Instructions for the Cypress Project 1. **Prerequisites**:     - Install [Node.js](https://nodejs.org/) if not already installed. Make sure to install a version compatible with your project dependencies (check the `package.json` file for compatibility).     - Ensure **npm** (Node Package Manager) is installed. It comes with Node.js.",
  "devDependencies": {
    "cypress": "^14.4.0",
    "cypress-iframe": "^1.0.1",
    "cypress-mochawesome-reporter": "^3.8.2",
    "cypress-watch-and-reload": "^1.10.19",
    "dayjs": "^1.11.13",
    "mocha": "^11.1.0",
    "multiple-cucumber-html-reporter": "^3.9.2"
  },
  "dependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "iframe": "^1.0.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "cucumberJson": {
      "generate": true,
      "outputFolder": "cypress/reports/cucumber-json",
      "filePrefix": "",
      "fileSuffix": ".cucumber"
    },
    "json": {
      "enabled": true
    }
  }
}
